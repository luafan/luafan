FROM alpine:3.16.9

WORKDIR /root/
# Build the local checkout, not a network clone. The bind mount is read-only and
# is never written to a layer, and build_docker_alpine.sh deletes its /opt/luafan
# staging copy inside the same RUN, so the image carries no luafan sources.
# Requires BuildKit (docker >= 23 enables it by default).
RUN --mount=type=bind,source=.,target=/src,ro \
    LUAFAN_SRC=/src sh /src/build_docker_alpine.sh && rm -rf /tmp/*
